 <defs>
  <linearGradient id="metal" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3b423d"/><stop offset=".45" stop-color="#1c211e"/><stop offset="1" stop-color="#0a0c0b"/></linearGradient>
  <linearGradient id="rim" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#c9ff8f"/><stop offset=".5" stop-color="#52b043"/><stop offset="1" stop-color="#0b5a0b"/></linearGradient>
  <linearGradient id="chrome" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset=".48" stop-color="#dfe4e0"/><stop offset=".52" stop-color="#9ba69e"/><stop offset="1" stop-color="#eef1ee"/></linearGradient>
  <linearGradient id="green" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#d4ff9c"/><stop offset=".5" stop-color="#5dc21e"/><stop offset="1" stop-color="#107c10"/></linearGradient>
  <radialGradient id="core" cx=".5" cy=".55" r=".55"><stop offset="0" stop-color="#5dc21e" stop-opacity=".5"/><stop offset=".6" stop-color="#0d4a0d" stop-opacity=".25"/><stop offset="1" stop-color="#000" stop-opacity="0"/></radialGradient>
  <linearGradient id="gloss" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".22"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient>
  <linearGradient id="word" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset=".55" stop-color="#e6ebe7"/><stop offset="1" stop-color="#aab5ad"/></linearGradient>
  <filter id="glow" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="6" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
  <filter id="drop" x="-20%" y="-20%" width="140%" height="150%"><feDropShadow dx="0" dy="6" stdDeviation="7" flood-color="#000" flood-opacity=".7"/></filter>
  <path id="P" d="M0 0 H62 C92 0 110 18 110 46 C110 74 92 92 62 92 H30 V140 H0 Z M30 26 V66 H58 C72 66 80 58 80 46 C80 34 72 26 58 26 Z" fill-rule="evenodd"/>
  <path id="X" d="M0 0 H32 L52 30 L72 0 H104 L68 52 L104 104 H72 L52 74 L32 104 H0 L36 52 Z"/>
  <g id="mono">
   <use href="#P" fill="url(#chrome)"/>
   <g transform="translate(54 50)" filter="url(#glow)"><use href="#X" fill="url(#green)"/></g>
   <g transform="translate(54 50)"><use href="#X" fill="none" stroke="#e6ffcc" stroke-opacity=".55" stroke-width="1.5"/></g>
  </g>
  <g id="tile">
   <rect x="0" y="0" width="200" height="200" rx="34" fill="url(#metal)" filter="url(#drop)"/>
   <rect x="0" y="0" width="200" height="200" rx="34" fill="url(#core)"/>
   <rect x="3" y="3" width="194" height="194" rx="31" fill="none" stroke="url(#rim)" stroke-width="5"/>
   <rect x="14" y="14" width="172" height="172" rx="24" fill="none" stroke="#b6f58a" stroke-opacity=".18" stroke-width="1.5"/>
   <path d="M6 40 Q6 6 40 6 H160 Q194 6 194 40 V86 Q100 64 6 92 Z" fill="url(#gloss)"/>
   <g transform="translate(38 38) scale(.8)"><use href="#mono"/></g>
  </g>
  <g id="wordmark">
   <text x="0" y="78" font-family="DejaVu Sans" font-weight="bold" font-size="78" letter-spacing="3" fill="url(#word)">PEGASUS</text>
   <g filter="url(#glow)"><text x="438" y="78" font-family="DejaVu Sans" font-weight="bold" font-size="78" fill="url(#green)">X</text></g>
   <rect x="2" y="98" width="492" height="2" fill="url(#rim)" opacity=".8"/>
   <text x="4" y="136" font-family="DejaVu Sans" font-size="26" letter-spacing="19" fill="#b2e894">FRONT END</text>
  </g>
 </defs>
